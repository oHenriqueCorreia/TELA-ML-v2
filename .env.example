# Configure these values in Vercel Project Settings > Environment Variables.
# Never commit actual credentials to this file.
SYNC_PAY_CLIENT_ID=
SYNC_PAY_CLIENT_SECRET=

# Optional. Set this to your final public URL so SyncPay always sends webhooks
# to the production deployment, for example: https://your-domain.com/api/syncpay-webhook
SYNC_PAY_WEBHOOK_URL=
